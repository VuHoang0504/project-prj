<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>

<jsp:include page="/common/header.jsp">
    <jsp:param name="title" value="Browse Products - VCLShop" />
</jsp:include>

<!-- Hero Banner with 2-Column Split Grid -->
<div class="hero-section mb-4" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.75) 0%, rgba(30, 27, 75, 0.72) 100%), url('/images/hero-promo-bg.jpg'), url('data:image/jpeg;base64,') center/cover no-repeat !important;">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-4">
            <!-- Left Column: Title, Promo Details, Voucher & Action Buttons -->
            <div class="col-lg-7 text-start">
                <div class="hero-promo-badge">
                    <span class="badge-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                    <span>Siêu Ưu Đãi Công Nghệ • Mega Tech Sale 2026</span>
                </div>

                <h1 class="hero-title">Khám Phá Công Nghệ Đỉnh Cao</h1>

                <p class="hero-subtitle">
                    Sắm các sản phẩm Laptop, Smartphone & Phụ kiện cao cấp với ưu đãi giảm trực tiếp <strong>đến 40%</strong>. Đảm bảo chính hãng, giao hàng tận nơi.
                </p>

                <!-- Premium Voucher Code Box -->
                <div class="voucher-box-premium">
                    <div>
                        <div class="voucher-desc"><i class="bi bi-ticket-perforated-fill text-pink me-1"></i> Mã giảm giá đặc biệt</div>
                        <div class="voucher-code">VCLTECH2026</div>
                    </div>
                    <span class="badge bg-danger px-3 py-2 rounded-pill fs-7">Giảm 500.000đ</span>
                </div>

                <!-- Call to Action Buttons -->
                <div class="hero-actions">
                    <a href="#productListArea" class="btn-hero-primary">
                        <i class="bi bi-bag-check-fill"></i> Mua Sắm Ngay
                    </a>
                    <a href="${pageContext.request.contextPath}/search?keyword=Laptop" class="btn-hero-secondary">
                        <i class="bi bi-fire text-warning"></i> Xem Deal Hot
                    </a>
                </div>
            </div>

            <!-- Right Column: 2x2 Feature Promo Cards -->
            <div class="col-lg-5">
                <div class="promo-grid">
                    <div class="promo-card-item">
                        <div class="promo-card-icon icon-pink">
                            <i class="bi bi-percent"></i>
                        </div>
                        <h6 class="promo-card-title">Ưu Đãi Đến 40%</h6>
                        <p class="promo-card-desc">Áp dụng trực tiếp cho danh mục Laptop & Điện thoại.</p>
                    </div>

                    <div class="promo-card-item">
                        <div class="promo-card-icon icon-cyan">
                            <i class="bi bi-truck"></i>
                        </div>
                        <h6 class="promo-card-title">Freeship 0Đ</h6>
                        <p class="promo-card-desc">Miễn phí giao hàng hỏa tốc trên toàn quốc.</p>
                    </div>

                    <div class="promo-card-item">
                        <div class="promo-card-icon icon-green">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h6 class="promo-card-title">Bảo Hành 24T</h6>
                        <p class="promo-card-desc">Cam kết chính hãng, 1 đổi 1 trong 30 ngày.</p>
                    </div>

                    <div class="promo-card-item">
                        <div class="promo-card-icon icon-amber">
                            <i class="bi bi-credit-card-2-front"></i>
                        </div>
                        <h6 class="promo-card-title">Trả Góp 0%</h6>
                        <p class="promo-card-desc">Thủ tục duyệt online nhanh chóng trong 5 phút.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Area -->
<div class="container mb-5" id="productListArea">
    <div class="row g-4">
        
        <!-- Left Filter Sidebar -->
        <div class="col-lg-3 col-md-4">
            <div class="filter-card">
                <div class="filter-header">
                    <span><i class="bi bi-funnel-fill text-primary me-2"></i> LỌC SẢN PHẨM</span>
                    <a href="${pageContext.request.contextPath}/home" class="text-muted small text-decoration-none" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                    </a>
                </div>

                <form action="${pageContext.request.contextPath}/home" method="get" id="filterForm">
                    <!-- Preserve search keyword if present -->
                    <c:if test="${not empty keyword}">
                        <input type="hidden" name="keyword" value="${keyword}">
                    </c:if>

                    <!-- Category Filter Section -->
                    <div class="mb-4">
                        <div class="filter-section-title">LOẠI SẢN PHẨM</div>
                        <div class="d-flex flex-column gap-1">
                            <label class="filter-item ${empty selectedCategory || selectedCategory == 'ALL' ? 'active' : ''}">
                                <span>
                                    <input type="radio" name="category" value="" ${empty selectedCategory || selectedCategory == 'ALL' ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                    Tất cả sản phẩm
                                </span>
                            </label>
                            
                            <c:set var="categories" value="${['Laptop', 'Smartphone', 'Tablet', 'Headphones', 'Smartwatch', 'Accessories']}" />
                            <c:forEach var="cat" items="${categories}">
                                <label class="filter-item ${selectedCategory == cat ? 'active' : ''}">
                                    <span>
                                        <input type="radio" name="category" value="${cat}" ${selectedCategory == cat ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                        ${cat}
                                    </span>
                                </label>
                            </c:forEach>
                        </div>
                    </div>

                    <hr class="text-border">

                    <!-- Price Range Section -->
                    <div class="mb-4">
                        <div class="filter-section-title">KHOẢNG GIÁ</div>
                        <div class="d-flex flex-column gap-1">
                            <label class="filter-item ${empty selectedPriceRange ? 'active' : ''}">
                                <span>
                                    <input type="radio" name="priceRange" value="" ${empty selectedPriceRange ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                    Tất cả mức giá
                                </span>
                            </label>
                            <label class="filter-item ${selectedPriceRange == '0-500' ? 'active' : ''}">
                                <span>
                                    <input type="radio" name="priceRange" value="0-500" ${selectedPriceRange == '0-500' ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                    Dưới $500
                                </span>
                            </label>
                            <label class="filter-item ${selectedPriceRange == '500-1000' ? 'active' : ''}">
                                <span>
                                    <input type="radio" name="priceRange" value="500-1000" ${selectedPriceRange == '500-1000' ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                    $500 - $1,000
                                </span>
                            </label>
                            <label class="filter-item ${selectedPriceRange == '1000-2000' ? 'active' : ''}">
                                <span>
                                    <input type="radio" name="priceRange" value="1000-2000" ${selectedPriceRange == '1000-2000' ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                    $1,000 - $2,000
                                </span>
                            </label>
                            <label class="filter-item ${selectedPriceRange == '2000-up' ? 'active' : ''}">
                                <span>
                                    <input type="radio" name="priceRange" value="2000-up" ${selectedPriceRange == '2000-up' ? 'checked' : ''} onchange="document.getElementById('filterForm').submit();" class="me-2">
                                    Trên $2,000
                                </span>
                            </label>
                        </div>
                    </div>

                    <hr class="text-border">

                    <!-- Sort By Section -->
                    <div class="mb-4">
                        <div class="filter-section-title">SẮP XẾP HÀNG</div>
                        <select name="sortBy" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit();">
                            <option value="price_asc" ${selectedSortBy == 'price_asc' ? 'selected' : ''}>Giá: Thấp đến Cao</option>
                            <option value="price_desc" ${selectedSortBy == 'price_desc' ? 'selected' : ''}>Giá: Cao đến Thấp</option>
                            <option value="name_asc" ${selectedSortBy == 'name_asc' ? 'selected' : ''}>Tên: A - Z</option>
                            <option value="name_desc" ${selectedSortBy == 'name_desc' ? 'selected' : ''}>Tên: Z - A</option>
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary-custom btn-sm">
                            <i class="bi bi-filter"></i> Áp dụng bộ lọc
                        </button>
                        <a href="${pageContext.request.contextPath}/home" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x-lg"></i> Xóa lọc
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Product Grid Section -->
        <div class="col-lg-9 col-md-8">
            
            <!-- Result Header & Active Filters Bar (Only shown when filters or search are active) -->
            <c:if test="${not empty keyword || (not empty selectedCategory && selectedCategory != 'ALL') || not empty selectedPriceRange}">
                <div class="card border-0 shadow-sm rounded-3 p-3 mb-4 bg-white">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Tìm thấy <span class="text-primary">${products.size() != null ? products.size() : 0}</span> sản phẩm
                            </h2>
                            
                            <!-- Display Active Filter Chips -->
                            <div class="d-flex flex-wrap align-items-center mt-2">
                                <c:if test="${not empty keyword}">
                                    <span class="active-chip">
                                        Từ khóa: "${keyword}"
                                        <a href="${pageContext.request.contextPath}/home?category=${selectedCategory}&priceRange=${selectedPriceRange}&sortBy=${selectedSortBy}"><i class="bi bi-x"></i></a>
                                    </span>
                                </c:if>
                                
                                <c:if test="${not empty selectedCategory && selectedCategory != 'ALL'}">
                                    <span class="active-chip">
                                        Loại: ${selectedCategory}
                                        <a href="${pageContext.request.contextPath}/home?keyword=${keyword}&priceRange=${selectedPriceRange}&sortBy=${selectedSortBy}"><i class="bi bi-x"></i></a>
                                    </span>
                                </c:if>

                                <c:if test="${not empty selectedPriceRange}">
                                    <span class="active-chip">
                                        Giá: 
                                        <c:choose>
                                            <c:when test="${selectedPriceRange == '0-500'}">Dưới $500</c:when>
                                            <c:when test="${selectedPriceRange == '500-1000'}">$500 - $1,000</c:when>
                                            <c:when test="${selectedPriceRange == '1000-2000'}">$1,000 - $2,000</c:when>
                                            <c:when test="${selectedPriceRange == '2000-up'}">Trên $2,000</c:when>
                                        </c:choose>
                                        <a href="${pageContext.request.contextPath}/home?keyword=${keyword}&category=${selectedCategory}&sortBy=${selectedSortBy}"><i class="bi bi-x"></i></a>
                                    </span>
                                </c:if>

                                <a href="${pageContext.request.contextPath}/home" class="text-danger small fw-bold ms-2 text-decoration-none">Xóa tất cả</a>
                            </div>
                        </div>
                    </div>
                </div>
            </c:if>

            <!-- Product Grid -->
            <c:choose>
                <c:when test="${empty products}">
                    <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-3">
                        <div class="py-4">
                            <i class="bi bi-search text-muted display-1 mb-3"></i>
                            <h3 class="h5 text-dark fw-bold">Không tìm thấy sản phẩm phù hợp</h3>
                            <p class="text-muted">Vui lòng thử thay đổi từ khóa hoặc điều chỉnh bộ lọc ở cột bên trái.</p>
                            <a href="${pageContext.request.contextPath}/home" class="btn btn-primary-custom mt-2 px-4">
                                Xem tất cả sản phẩm
                            </a>
                        </div>
                    </div>
                </c:when>

                <c:otherwise>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                        <c:forEach var="p" items="${products}">
                            <div class="col">
                                <div class="card product-card">
                                    <!-- Image Container -->
                                    <div class="card-img-wrapper">
                                        <c:choose>
                                            <c:when test="${not empty p.imageURL}">
                                                <img src="${p.imageURL}" class="card-img-top" alt="${p.productName}">
                                            </c:when>
                                            <c:otherwise>
                                                <div class="d-flex align-items-center justify-content-center h-100 bg-light text-muted">
                                                    <i class="bi bi-image fs-1"></i>
                                                </div>
                                            </c:otherwise>
                                        </c:choose>
                                    </div>

                                    <!-- Card Body -->
                                    <div class="card-body">
                                        <span class="product-type">${p.productType}</span>
                                        <h5 class="product-title" title="${p.productName}">${p.productName}</h5>

                                        <div class="product-price">
                                            <fmt:formatNumber value="${p.price}" type="currency" currencySymbol="$" maxFractionDigits="0" />
                                        </div>

                                        <div class="d-grid gap-2 mt-auto">
                                            <a href="${pageContext.request.contextPath}/product-detail?id=${p.productID}" class="btn btn-secondary-custom btn-sm">
                                                <i class="bi bi-info-circle"></i> Chi tiết
                                            </a>
                                            <a href="${pageContext.request.contextPath}/cart?action=add&productID=${p.productID}" class="btn btn-primary-custom btn-sm">
                                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </c:forEach>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</div>

<jsp:include page="/common/footer.jsp" />
